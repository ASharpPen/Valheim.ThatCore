<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	  <RootNamespace>ThatCore.Valheim.Generator</RootNamespace>
	  <LangVersion>preview</LangVersion>
	  <Authors>A Sharp Pen</Authors>
	  <Version>1.1.0</Version>

	  <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <IsRoslynComponent>true</IsRoslynComponent>
	  <IncludeBuildOutput>false</IncludeBuildOutput>
	  <DevelopmentDependency>true</DevelopmentDependency>
	  <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	  <NoWarn>$(NoWarn);NU5128</NoWarn>

	  <Description>Emits the ThatCore, ThatCore.Shared and ThatCore.Valheim source directly into the assembly that references it.
This is primarily core tooling used by the authors other Valheim mods.</Description>

	  <PackageReadmeFile>README.md</PackageReadmeFile>

	  <RepositoryUrl>https://github.com/ASharpPen/Valheim.ThatCore</RepositoryUrl>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

		<None Include="build\ThatCore.Valheim.Generator.props" Pack="true" PackagePath="build" />
		<None Include="build\ThatCore.Valheim.Generator.targets" Pack="true" PackagePath="build" />

		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
